# ---------------------------------------------------------------------------
# Copy to .env and edit.  .env is git-ignored; never commit real credentials.
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
QUANTLAB_ENV=local              # local | ci | docker | production
QUANTLAB_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
QUANTLAB_LOG_JSON=false         # true -> machine-readable logs (use in Docker)

# --- Database ------------------------------------------------------------
# Full URL wins if set.  Otherwise the parts below are assembled.
# QUANTLAB_DATABASE_URL=postgresql+psycopg://quantlab:quantlab@localhost:5432/quantlab
QUANTLAB_POSTGRES_HOST=localhost
QUANTLAB_POSTGRES_PORT=5432
QUANTLAB_POSTGRES_USER=quantlab
QUANTLAB_POSTGRES_PASSWORD=change-me
QUANTLAB_POSTGRES_DB=quantlab
QUANTLAB_DB_ECHO=false

# --- Storage layout ------------------------------------------------------
QUANTLAB_DATA_DIR=./data

# --- Ingestion behaviour -------------------------------------------------
QUANTLAB_HTTP_TIMEOUT_SECONDS=30
QUANTLAB_HTTP_MAX_RETRIES=5
QUANTLAB_HTTP_BACKOFF_BASE_SECONDS=0.5
QUANTLAB_HTTP_BACKOFF_MAX_SECONDS=30
QUANTLAB_DEFAULT_RATE_LIMIT_PER_SECOND=4

# --- Providers -----------------------------------------------------------
# Stooq and the FRED CSV endpoint need no key.  A FRED API key is optional and
# only unlocks the JSON API (higher rate limits, vintage data).
# QUANTLAB_FRED_API_KEY=

# --- Research defaults ---------------------------------------------------
QUANTLAB_RANDOM_SEED=20240101
QUANTLAB_TRADING_DAYS_PER_YEAR=252

# --- docker compose ------------------------------------------------------
# Read by docker-compose.yml only (Compose loads ./.env automatically).  These
# are separate from the QUANTLAB_* variables above: those configure the
# application, these configure the containers around it.  Every one has a
# throwaway default so `docker compose up` works with no .env at all; set real
# values for anything that is not a local demo.
POSTGRES_USER=quantlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quantlab

# Host ports.  All are bound to 127.0.0.1 in docker-compose.yml; change the
# number here if something else already owns the port.
POSTGRES_PORT=5432
API_PORT=8000
DASHBOARD_PORT=8501
AIRFLOW_PORT=8080

# Airflow web UI admin account, created once by the airflow-init container.
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=airflow@example.com
